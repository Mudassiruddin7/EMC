# KEY=VALUE settings passed to scripts/pipeline.sh by scripts/supervise.py
# run r2 on a fresh machine: everything from scratch with twice the data of r1 (4M generated
# tokens), training from the baseline head; the bf16 variant is not evaluated
RUN_ID_FORCE=r2
GEN_TOKENS=4000000
GEN_MINUTES=55
EXTRACT_MINUTES=35
TRAIN_MINUTES=40
EVAL_ALT=0
