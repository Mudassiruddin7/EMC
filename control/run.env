# KEY=VALUE settings passed to scripts/pipeline.sh by scripts/supervise.py
# run r4 = options A + B + C on a fresh machine:
#  A  more data: r3's 6.1M generated tokens reused from the dataset repo, total 9.5M, features in FP8
#  B  the new answers mostly long-form writing (the weakest domain, the largest share of eval tokens)
#  C  an EAGLE-3 draft trained online from the same target forward passes, then evaluated
# the MTP head is retrained from r3 with r3's winning recipe; r3 stays the submission unless beaten
RUN_ID_FORCE=r4
FP8_OK=1
FETCH_GEN=mudassiruddin21/EMC:runs/r3/data/gen
GEN_TOKENS=9500000
GEN_MINUTES=50
GEN_APPEND=1
GEN_SHARE=longform=0.6,chat=0.2,code=0.1,math=0.1
EXTRACT_FP8=1
EXTRACT_BATCH_TOKENS=8192
EXTRACT_MINUTES=100
EAGLE=1
EAGLE_LR=3e-4
EAGLE_FULL_MIN=2.8
RUN_NAME=main4
TRAIN_INIT=models/r3-bf16
TRAIN_INIT_HF=mudassiruddin21/EMC:submissions/r3/main3-bf16
TRAIN_ARGS=--step-w auto --topk 10 --floor 0.3 --rel-lr 1e-3 --lora 128
TRAIN_EPOCHS=1.5
TRAIN_MINUTES=55
EVAL_ALT=0
BENCH=0
